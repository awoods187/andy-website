{
  "name": "andy-website",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "astro sync && tsc --noEmit",
    "validate:yaml": "node scripts/validate-yaml-frontmatter.mjs",
    "validate": "npm run format:check && npm run lint && npm run type-check && npm run validate:yaml && npm run test",
    "lighthouse": "lighthouse https://andywoods.me/blog/hybrid-blog-system-2025 --output=json --output=html --output-path=./reports/lighthouse/lighthouse-report --chrome-flags=\"--headless\" --only-categories=performance,accessibility,best-practices,seo",
    "lighthouse:view": "open reports/lighthouse/lighthouse-report.report.html",
    "prepare": "command -v pre-commit > /dev/null && pre-commit install || echo 'pre-commit not installed, skipping hook setup'"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.0.3",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.8",
    "tailwindcss": "^4.1.14"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "devalue": "^5.8.1",
    "esbuild": "^0.28.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@eslint/js": "^10.0.1",
    "@types/js-yaml": "^4.0.9",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "@vitest/coverage-v8": "^5.0.5",
    "@vitest/ui": "^5.0.5",
    "eslint": "^10.13.0",
    "eslint-plugin-astro": "^3.2.1",
    "happy-dom": "^21.0.4",
    "js-yaml": "^5.5.0",
    "lighthouse": "^13.5.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
